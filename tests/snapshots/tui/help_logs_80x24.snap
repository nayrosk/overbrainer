" 1 Dataset   2 Pipeline   3 Training   4 Logs                       rust_expert "
"┌ logs: INFO and above ────────────────────────────────────────────────────────┐"
"│                                                                              │"
"│                                                                              │"
"│                                                                              │"
"│ ┌ keys: Logs ──────────────────────────────────────────────────────────────┐ │"
"│ │1 2 3 4, Tab, Shift-Tab    switch view                                    │ │"
"│ │?                          this help (Esc, ? or q closes it)              │ │"
"│ │q, Ctrl-C                  quit                                           │ │"
"│ │R                          reload the data files and runs                 │ │"
"│ │r                          run a pipeline stage, or run (asks which)      │ │"
"│ │y, n Esc                   in a dialog: confirm, cancel (default: no)     │ │"
"│ │k j, Up Down, PgUp PgDn    scroll                                         │ │"
"│ │G, End                     follow the newest lines                        │ │"
"│ │f                          cycle level: error, warn, info, debug, trace   │ │"
"│ │                                                                          │ │"
"│ │e, d, r and t are refused while a stage, an edit or a training start runs │ │"
"│ │in this TUI; an overbrainer command in another terminal is not locked out.│ │"
"│ └──────────────────────────────────────────────────────────────────────────┘ │"
"│                                                                              │"
"│                                                                              │"
"│                                                                              │"
"└──────────────────────────────────────────────────────────────────────────────┘"
"                                                                          ? help"
